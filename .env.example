# Database Configuration (PostgreSQL 16)
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=shopfast

# Redis Configuration (Redis 7)
REDIS_PORT=6379

# Server Configuration
PORT=3000
NODE_ENV=production
JWT_SECRET=shopfast_jwt_super_secret_key_2026_module6_defense
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=shopfast_refresh_jwt_super_secret_key_2026_module6
JWT_REFRESH_EXPIRES_IN=7d

# Google Gemini AI API Key (Dán key từ Google AI Studio vào đây)
GEMINI_API_KEY=your_gemini_api_key_here

# Client URL (CORS & WebSockets)
CLIENT_URL=*
